(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes    ;; Eliminates key delay during fast typing
  linux-dev-names-include (
    "AT Raw Set 2 keyboard"
    "AT Translated Set 2 keyboard"
    "Logitech Wireless Keyboard PID:4023"
    "ITE Tech. Inc. ITE Device(8295) Keyboard"
    "ITE Tech. Inc. ITE Device(8910) Keyboard"
    "Keychron K2"
  )
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc Insert Delete
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt      spc        ralt rmet rctl
)

(defvar tt 200)
(defvar ht 250)

(defalias
  ;; Layer Toggles
  spcfn  (tap-hold $tt $ht spc (layer-while-held navigation))
  altcpp (tap-hold $tt $ht lalt (layer-while-held codingCPP))
  altmac (tap-hold $tt $ht ralt (layer-while-held macroLayer))

  ;; Dynamic Macro Recording Controls (3 Slots)
  rec_m0 (dynamic-macro-record 0)
  ply_m0 (dynamic-macro-play 0)
  rec_m1 (dynamic-macro-record 1)
  ply_m1 (dynamic-macro-play 1)
  rec_m2 (dynamic-macro-record 2)
  ply_m2 (dynamic-macro-play 2)

  ;; Smooth Mouse Movement Keys (Smooth 1-pixel precision movement)
  mup  (movemouse-accel-up 1 1000 1 5)
  mdn  (movemouse-accel-down 1 1000 1 5)
  mlft (movemouse-accel-left 1 1000 1 5)
  mrgt (movemouse-accel-right 1 1000 1 5)
  mclk mlft
  rclk mrgt

  ;; Symbol Macros
  box      (macro S-; S-;)                                     ;; ::
  arrow    (macro - S-.)                                       ;; ->
  darrow   (macro = S-.)                                       ;; =>
  leftLeft (macro S-, S-,)                                     ;; <<
  or       (macro S-\ S-\)                                     ;; ||
  and      (macro S-7 S-7)                                     ;; &&

  ;; Adding ; at end of line in nvim
  eof (macro esc S-a ; esc)

  ;; Enclosures with auto-cursor repositioning
  triclose (macro S-, S-. left)                                ;; <> (cursor inside)
  brc      (macro S-[ S-] left)                                ;; {}
  prn      (macro S-9 S-0 left)                                ;; ()
  brk      (macro [ ] left)                                    ;; []

  ;; C++ Types & Casting Macros
  std      (macro s t d S-; S-;)                                       ;; std::
  sizet    (macro s t d S-; S-; s i z e S-- t)                         ;; std::size_t
  vec      (macro s t d S-; S-; v e c t o r S-, S-. left)               ;; std::vector<|>
  str      (macro s t d S-; S-; s t r i n g)                            ;; std::string
  scast    (macro s t a t i c S-- c a s t S-, S-.  S-9 S-0 left left left)      ;; static_cast<|>()

  ;; Neovim Save & Quit Macros
  vw       (macro S-; w ret)                                     ;; :w<Enter>
  vq!      (macro S-; q S-1 ret)                                 ;; :q!<Enter>

  ;; C++ Structure Macros
  cppfor   (macro f o r S-9 S-0 S-[ S-] left ret up end left left)
  cppif    (macro i f S-9 S-0 S-[ S-] left ret up end left left)
  cppstr   (macro s t r u c t S-[ S-] ; left left ret )

  ;; Fixed Word Deletion for Terminals & GUI Word Jumps
  cbspc    C-bspc
  cwlft    C-left
  cwrgt    C-right

  ;; Home Row Mods (tap-hold-release)
  A_H   (tap-hold-release $tt $ht a lalt)
  S_H   (tap-hold-release $tt $ht s lmet)
  D_H   (tap-hold-release $tt $ht d lshift)
  F_H   (tap-hold-release $tt $ht f lctl)

  J_H   (tap-hold-release $tt $ht j lctl)
  K_H   (tap-hold-release $tt $ht k lshift)
  L_H   (tap-hold-release $tt $ht l lmet)
  SCL_H (tap-hold-release $tt $ht ; lalt)
)

(deflayer base
  esc      f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc Insert Delete
  grv      1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab      q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc      @A_H @S_H @D_H @F_H g    h    @J_H @K_H @L_H @SCL_H '    ret
  lsft     z    x    c    v    b    n    m    ,    .    /    rsft
  lctl     lmet @altcpp   @spcfn      @altmac rmet rctl
)

(deflayer navigation
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc Insert Delete
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  @vq! @vw  _    @cbspc _  _    home pgup pgdn end  [    ]    \
  esc  _    _    _    _    _    left down up   rght _    '    ret
  lsft _    _    _    _    _    @cwlft @cwrgt ,  .    /    rsft
  lctl lmet lalt      @spcfn      ralt rmet rctl
)

(deflayer codingCPP
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc Insert Delete
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  _    @brc @prn @brk @triclose @or @and @arrow @darrow @leftLeft @box [ ] \
  esc  @std @sizet @vec @str @cppfor @cppif @cppstr @scast @eof _    '    ret
  lsft _    _    _    _    _    _    _    ,    .    /    rsft
  lctl lmet lalt      @spcfn      ralt rmet rctl
)

(deflayer macroLayer
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc Insert Delete
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  _    _    _  _    _    _    _    _    @rec_m0 @rec_m1 @rec_m2 [  ]    \
  esc  @mlft @mdn @mup @mrgt _    _    _    @ply_m0 @ply_m1 @ply_m2 '    ret
  lsft _    _    _    _    _    @mclk @rclk ,  .    /    rsft
  lctl lmet lalt      @spcfn      ralt rmet rctl
)
